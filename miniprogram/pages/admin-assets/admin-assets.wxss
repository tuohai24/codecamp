.sticky { position: sticky; top: 0; z-index: 10; background: var(--bg); padding: 20rpx 28rpx 14rpx; border-bottom: 1rpx solid var(--border); }
.chips { display: flex; gap: 12rpx; margin-top: 16rpx; }
.chip {
  height: 56rpx; line-height: 56rpx; padding: 0 24rpx; border-radius: 999rpx;
  font-size: 24rpx; background: var(--surface); border: 1rpx solid var(--border); color: var(--text-2);
}
.chip.on { background: var(--ink); color: #fff; border-color: var(--ink); font-weight: 600; }

.assets { gap: 16rpx; }
.asset { background: var(--surface); border: 1rpx solid var(--border); border-radius: 16rpx; padding: 12rpx; }
.a-thumb {
  height: 150rpx; background: var(--surface-2); border-radius: 10rpx;
  display: flex; align-items: center; justify-content: center; overflow: hidden;
}
.a-img { width: 100%; height: 100%; }
.a-audio { font-size: 46rpx; }
.a-name { font-size: 24rpx; font-weight: 600; margin-top: 10rpx; }
.a-meta { font-size: 20rpx; color: var(--muted); margin-top: 4rpx; }
.a-ops { display: flex; gap: 16rpx; margin-top: 10rpx; }
.op { font-size: 22rpx; color: var(--brand-d); }
.op.danger { color: var(--red); }

.mask { position: fixed; inset: 0; background: rgba(15, 15, 20, 0.42); z-index: 40; }
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 41;
  background: var(--surface); border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
}
.preview { height: 240rpx; background: var(--surface-2); border-radius: 14rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 20rpx; }
.preview-img { max-width: 100%; max-height: 100%; }

.has-bar { padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); }

.cover { width: 100%; height: 420rpx; background: var(--surface-2); display: flex; align-items: center; justify-content: center; }
.cover-img { width: 100%; height: 100%; display: block; }
.cover-ph { font-size: 56rpx; font-weight: 700; color: #a1a1aa; letter-spacing: 4rpx; }

.head { padding: 28rpx 28rpx 8rpx; background: var(--surface); border-bottom: 1rpx solid var(--border); }
.title { font-size: 40rpx; font-weight: 700; line-height: 1.35; margin: 16rpx 0 14rpx; letter-spacing: -0.5rpx; }
.author { display: flex; align-items: center; gap: 12rpx; font-size: 24rpx; }
.desc { margin-top: 16rpx; font-size: 26rpx; color: var(--text-2); line-height: 1.7; padding-bottom: 12rpx; }

.link { font-size: 24rpx; }

.code-box {
  margin-top: 16rpx; background: #101014; border-radius: 14rpx; padding: 20rpx;
  max-height: 420rpx;
}
.code {
  color: #e4e4e7; font-family: Menlo, monospace; font-size: 22rpx;
  line-height: 1.7; white-space: pre; display: block;
}

.output { margin-top: 20rpx; background: var(--surface-2); border-radius: 14rpx; padding: 20rpx; }
.out-hd { display: flex; align-items: center; justify-content: space-between; font-size: 24rpx; margin-bottom: 12rpx; }
.out-ok { color: #15803d; font-weight: 600; }
.out-fail { color: #dc2626; font-weight: 600; }
.out-body { max-height: 520rpx; }
.out-text { display: block; font-family: Menlo, monospace; font-size: 22rpx; line-height: 1.65; white-space: pre-wrap; color: var(--text); }
.out-err { display: block; font-family: Menlo, monospace; font-size: 22rpx; line-height: 1.65; white-space: pre-wrap; color: #dc2626; margin-top: 8rpx; }
.out-img { width: 100%; margin-top: 12rpx; border-radius: 10rpx; }

.cmt { display: flex; gap: 16rpx; padding: 24rpx 24rpx; border-bottom: 1rpx solid var(--border); }
.cmt:last-child { border-bottom: none; }
.cmt-main { min-width: 0; }
.cmt-name { font-size: 26rpx; font-weight: 600; }
.cmt-time { font-size: 22rpx; }
.cmt-text { font-size: 26rpx; line-height: 1.65; margin-top: 6rpx; word-break: break-all; }
.cmt-del { display: inline-block; margin-top: 10rpx; font-size: 22rpx; color: var(--red); }

.act { display: flex; align-items: center; gap: 6rpx; padding-right: 8rpx; }
.act-icon { font-size: 40rpx; color: var(--muted); line-height: 1; }
.act-icon.liked { color: #e11d48; }
.act-n { font-size: 24rpx; color: var(--muted); }

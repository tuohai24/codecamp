.chips { display: flex; align-items: center; gap: 12rpx; padding: 20rpx 28rpx; }
.chip {
  height: 56rpx; line-height: 56rpx; padding: 0 22rpx; border-radius: 999rpx;
  font-size: 24rpx; color: var(--text-2); background: var(--surface);
  border: 1rpx solid var(--border);
}
.chip.on { background: var(--ink); color: #fff; border-color: var(--ink); font-weight: 600; }

.item { border-bottom: 1rpx solid var(--border); }
.item:last-child { border-bottom: none; }
.item-main { display: flex; gap: 20rpx; padding: 24rpx; align-items: center; }
.item-main:active { background: var(--surface-2); }

.thumb {
  width: 132rpx; height: 96rpx; border-radius: 12rpx; flex-shrink: 0;
  background: var(--surface-2); display: flex; align-items: center; justify-content: center;
  overflow: hidden;
}
.thumb-img { width: 100%; height: 100%; }
.thumb-ph { font-size: 24rpx; font-weight: 700; color: #a1a1aa; letter-spacing: 1rpx; }

.info { min-width: 0; }
.name { font-size: 28rpx; font-weight: 600; }

.ops { display: flex; gap: 28rpx; padding: 0 24rpx 22rpx; }
.op { font-size: 24rpx; color: var(--brand-d); }
.op.danger { color: var(--red); }

<view class="page">
  <view class="chips">
    <view
      wx:for="{{types}}"
      wx:key="key"
      class="chip {{type === item.key ? 'on' : ''}}"
      data-key="{{item.key}}"
      bindtap="pickType"
    >{{item.name}}</view>
    <view class="grow"></view>
    <view class="chip on" bindtap="create">＋ 新建</view>
  </view>

  <view class="wrap">
    <view wx:if="{{loading}}" class="loading">加载中…</view>

    <block wx:elif="{{!logged}}">
      <empty icon="🔒" text="登录后可以查看和管理自己的作品" />
      <button class="btn btn-primary btn-block" bindtap="goLogin">去登录</button>
    </block>

    <block wx:elif="{{items.length}}">
      <view class="list">
        <view class="item" wx:for="{{items}}" wx:key="id">
          <view class="item-main" data-id="{{item.id}}" bindtap="open">
            <view class="thumb">
              <image wx:if="{{item.thumb}}" class="thumb-img" src="{{item.thumb}}" mode="aspectFill" />
              <text wx:else class="thumb-ph">{{item.type === 'python' ? 'PY' : 'SB3'}}</text>
            </view>
            <view class="grow info">
              <view class="row gap-8">
                <text class="name wrap-text">{{item.title}}</text>
                <text class="tag {{item.published ? 'tag-ok' : ''}}">{{item.published ? '已发布' : '草稿'}}</text>
              </view>
              <view class="tip">{{item.typeText}} · ♥ {{item.likes}} · {{item.time}}</view>
            </view>
          </view>
          <view class="ops">
            <text class="op" data-id="{{item.id}}" data-type="{{item.type}}" bindtap="edit">编辑</text>
            <text class="op" data-id="{{item.id}}" data-published="{{item.published}}" bindtap="togglePublish">{{item.published ? '下线' : '发布'}}</text>
            <text class="op danger" data-id="{{item.id}}" bindtap="remove">删除</text>
          </view>
        </view>
      </view>
    </block>

    <empty wx:else icon="🎨" text="还没有作品，点右上角「新建」开始创作" />
  </view>

  <view class="safe-bottom"></view>
</view>

.bar {
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 28rpx; background: var(--surface);
  border-bottom: 1rpx solid var(--border);
}
.title-input { flex: 1; height: 64rpx; font-size: 30rpx; font-weight: 600; }

.editor-wrap { margin: 20rpx 28rpx 0; background: #101014; border-radius: var(--radius); overflow: hidden; }
.ed-hd {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 22rpx; border-bottom: 1rpx solid #26262c;
}
.ed-hd .muted { color: #a1a1aa; font-size: 22rpx; }
.ed-hd .link { color: #a5b4fc; }

.editor {
  width: 100%; height: 620rpx; padding: 20rpx 22rpx;
  color: #e4e4e7; font-family: Menlo, monospace; font-size: 24rpx; line-height: 1.7;
  background: transparent;
}
.editor-ph { color: #52525b; }

.actions { display: flex; gap: 16rpx; padding: 20rpx 28rpx 0; }

.out { margin: 20rpx 28rpx 0; background: var(--surface); border: 1rpx solid var(--border); border-radius: var(--radius); padding: 22rpx; }
.out-hd { display: flex; align-items: center; justify-content: space-between; font-size: 24rpx; margin-bottom: 12rpx; }
.out-ok { color: #15803d; font-weight: 600; }
.out-fail { color: #dc2626; font-weight: 600; }
.out-body { max-height: 560rpx; }
.out-text { display: block; font-family: Menlo, monospace; font-size: 22rpx; white-space: pre-wrap; line-height: 1.65; }
.out-err { display: block; font-family: Menlo, monospace; font-size: 22rpx; white-space: pre-wrap; line-height: 1.65; color: #dc2626; }
.out-img { width: 100%; margin-top: 12rpx; border-radius: 10rpx; }

.hint { margin: 20rpx 28rpx; font-size: 22rpx; }

<view class="page">
  <view class="bar">
    <input
      class="title-input"
      value="{{title}}"
      bindinput="onTitle"
      placeholder="给作品起个名字"
      placeholder-class="placeholder"
      maxlength="40"
    />
    <text class="tag {{published ? 'tag-ok' : ''}}">{{published ? '已发布' : '草稿'}}</text>
  </view>

  <view class="editor-wrap">
    <view class="ed-hd">
      <text class="muted">main.py</text>
      <text class="muted link" bindtap="pickSnippet">插入示例</text>
    </view>
    <textarea
      class="editor"
      value="{{code}}"
      bindinput="onCode"
      maxlength="-1"
      auto-height="{{false}}"
      show-confirm-bar="{{false}}"
      adjust-position="{{true}}"
      disable-default-padding="{{true}}"
      placeholder="# 在这里写 Python 代码"
      placeholder-class="editor-ph"
    />
  </view>

  <view class="actions">
    <button class="btn btn-ghost btn-sm grow" bindtap="run" disabled="{{running}}">{{running ? '运行中…' : '▶ 运行'}}</button>
    <button class="btn btn-ghost btn-sm grow" bindtap="save" disabled="{{saving}}">{{saving ? '保存中…' : '保存'}}</button>
    <button class="btn btn-primary btn-sm grow" bindtap="publish">发布</button>
  </view>

  <view class="out" wx:if="{{result}}">
    <view class="out-hd">
      <text class="{{result.ok ? 'out-ok' : 'out-fail'}}">{{result.ok ? '运行成功' : '运行出错'}}</text>
      <text class="muted">{{result.ms}} ms</text>
    </view>
    <scroll-view scroll-y class="out-body" wx:if="{{result.stdout || result.stderr}}">
      <text class="out-text" wx:if="{{result.stdout}}">{{result.stdout}}</text>
      <text class="out-err" wx:if="{{result.stderr}}">{{result.stderr}}</text>
    </scroll-view>
    <image wx:for="{{images}}" wx:key="index" src="{{item}}" mode="widthFix" class="out-img" />
  </view>

  <view class="tip hint">提示：小程序里的编辑器只支持纯文本输入；需要更强的提示和补全时，可在电脑浏览器里打开站点编辑。</view>
  <view class="safe-bottom"></view>
</view>

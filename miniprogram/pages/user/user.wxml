<view class="page">
  <view class="loading" wx:if="{{loading}}">加载中…</view>

  <empty wx:elif="{{!u}}" icon="🕵️" text="用户不存在" />

  <block wx:else>
    <view class="hd">
      <image wx:if="{{avatar}}" class="avatar avatar-lg" src="{{avatar}}" mode="aspectFill" />
      <view wx:else class="avatar avatar-lg avatar-fallback">{{initial}}</view>
      <view class="grow info">
        <view class="row gap-8">
          <text class="h2">{{u.nickname}}</text>
          <text class="tag">{{roleText}}</text>
        </view>
        <view class="tip mt-8">{{u.bio || '还没有填写简介'}}</view>
        <view class="tip mt-8">{{joined}}加入</view>
      </view>
    </view>

    <view class="wrap">
      <view class="card-hd">
        <text class="h3">公开作品 {{items.length}}</text>
      </view>
      <view class="grid-2" wx:if="{{items.length}}">
        <project-card wx:for="{{items}}" wx:key="id" item="{{item}}" showAuthor="{{false}}" />
      </view>
      <empty wx:else icon="🎨" text="还没有公开作品" />
    </view>
  </block>

  <view class="safe-bottom"></view>
</view>

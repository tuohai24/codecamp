<view class="page">
  <view class="sticky">
    <input class="input" placeholder="搜索作品标题或作者" placeholder-class="placeholder" value="{{keyword}}" bindinput="onKeyword" />
    <view class="chips">
      <view
        wx:for="{{filters}}"
        wx:key="key"
        class="chip {{filter === item.key ? 'on' : ''}}"
        data-key="{{item.key}}"
        bindtap="pickFilter"
      >{{item.name}}</view>
    </view>
  </view>

  <view class="wrap">
    <view wx:if="{{loading}}" class="loading">加载中…</view>

    <block wx:elif="{{shown.length}}">
      <view class="list">
        <view class="item" wx:for="{{shown}}" wx:key="id">
          <view class="between">
            <view class="grow" data-id="{{item.id}}" bindtap="open">
              <view class="row gap-8">
                <text class="strong wrap-text">{{item.title}}</text>
                <text class="tag {{item.published ? 'tag-ok' : ''}}">{{item.published ? '已发布' : '未发布'}}</text>
              </view>
              <view class="tip">{{item.nickname}} · {{item.typeText}} · ♥ {{item.likes}} · {{item.views}} 浏览 · {{item.time}}</view>
            </view>
          </view>
          <view class="ops">
            <text class="op" data-id="{{item.id}}" data-published="{{item.published}}" bindtap="toggle">{{item.published ? '下线' : '上线'}}</text>
            <text class="op danger" data-id="{{item.id}}" data-title="{{item.title}}" bindtap="remove">删除</text>
          </view>
        </view>
      </view>
      <view class="tip center mt-16">共 {{shown.length}} 个作品</view>
    </block>

    <empty wx:else icon="🎨" text="没有符合条件的作品" />
  </view>

  <view class="safe-bottom"></view>
</view>

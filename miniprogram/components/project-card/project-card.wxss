.p-card { position: relative; }
.p-card-hover { transform: scale(0.992); }
.thumb-img { width: 100%; height: 100%; display: block; }
.badge {
  position: absolute; top: 14rpx; left: 14rpx;
  height: 36rpx; padding: 0 12rpx; border-radius: 8rpx;
  font-size: 20rpx; font-weight: 600; line-height: 36rpx;
  background: rgba(255, 255, 255, 0.92);
}
.badge-py { color: #4338ca; }
.badge-sb { color: #92400e; }
.author { max-width: 180rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

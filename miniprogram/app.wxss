/* =========================================================================
   CodeCamp 小程序 · 全局样式
   设计语言与 Web 端 v1.3 一致：中性灰阶（zinc）骨架 + 单一靛蓝点缀 + 墨黑主按钮
   ========================================================================= */

page {
  --bg: #fafafa;
  --surface: #ffffff;
  --surface-2: #f4f4f5;
  --text: #131316;
  --text-2: #3f3f46;
  --muted: #71717a;
  --border: #e8e8eb;
  --border-2: #dedee3;
  --brand: #4f46e5;
  --brand-d: #4338ca;
  --brand-soft: #eef0fe;
  --ink: #141417;
  --ink-hover: #2b2b30;
  --ink-text: #ffffff;
  --green: #16a34a;
  --amber: #d97706;
  --red: #dc2626;
  --radius: 20rpx;

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  -webkit-font-smoothing: antialiased;
}

view, text, scroll-view, swiper, button, input, textarea, image, navigator {
  box-sizing: border-box;
}

/* ---------------- 布局 ---------------- */
.page { min-height: 100vh; padding-bottom: 40rpx; }
.wrap { padding: 24rpx 28rpx; }
.row { display: flex; align-items: center; }
.col { display: flex; flex-direction: column; }
.between { display: flex; align-items: center; justify-content: space-between; }
.center { display: flex; align-items: center; justify-content: center; }
.grow { flex: 1; min-width: 0; }
.wrap-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.gap-8 { gap: 8rpx; }
.gap-12 { gap: 12rpx; }
.gap-16 { gap: 16rpx; }
.gap-24 { gap: 24rpx; }
.mt-8 { margin-top: 8rpx; }
.mt-12 { margin-top: 12rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }

/* ---------------- 文本 ---------------- */
.h1 { font-size: 44rpx; font-weight: 700; letter-spacing: -0.5rpx; }
.h2 { font-size: 34rpx; font-weight: 650; }
.h3 { font-size: 30rpx; font-weight: 600; }
.muted { color: var(--muted); }
.tip { color: var(--muted); font-size: 24rpx; line-height: 1.7; }
.strong { font-weight: 650; }
.num { font-family: 'SF Mono', Menlo, monospace; font-variant-numeric: tabular-nums; }
.ellipsis-2 {
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ---------------- 卡片 ---------------- */
.card {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  padding: 28rpx;
}
.card-flat { background: var(--surface); border-radius: var(--radius); overflow: hidden; }
.card-hd { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.card-hd .h3 { font-size: 30rpx; }
.divider { height: 1rpx; background: var(--border); margin: 24rpx 0; }

/* ---------------- 按钮 ---------------- */
.btn {
  display: inline-flex; align-items: center; justify-content: center;
  height: 84rpx; padding: 0 32rpx; border-radius: 16rpx;
  font-size: 28rpx; font-weight: 600; line-height: 1;
  background: var(--surface-2); color: var(--text);
  border: 1rpx solid transparent;
}
.btn::after { border: none; }
.btn-primary { background: var(--ink); color: var(--ink-text); }
.btn-primary:active { background: var(--ink-hover); }
.btn-brand { background: var(--brand); color: #fff; }
.btn-ghost { background: transparent; border-color: var(--border-2); color: var(--text-2); }
.btn-danger { background: #fef2f2; color: var(--red); }
.btn-sm { height: 64rpx; padding: 0 22rpx; font-size: 24rpx; border-radius: 12rpx; }
.btn-block { display: flex; width: 100%; }
.btn[disabled] { opacity: 0.5; }

/* ---------------- 表单 ---------------- */
.field { margin-bottom: 24rpx; }
.label { display: block; font-size: 26rpx; font-weight: 600; color: var(--text-2); margin-bottom: 12rpx; }
.input, .textarea {
  width: 100%; background: var(--surface); color: var(--text);
  border: 1rpx solid var(--border-2); border-radius: 14rpx;
  padding: 0 24rpx; height: 84rpx; font-size: 28rpx;
}
.textarea { height: 240rpx; padding: 20rpx 24rpx; line-height: 1.6; }
.input-focus { border-color: var(--brand); }
.placeholder { color: #a1a1aa; }

/* ---------------- 标签 ---------------- */
.tag {
  display: inline-flex; align-items: center; height: 40rpx; padding: 0 14rpx;
  border-radius: 8rpx; font-size: 22rpx; font-weight: 600;
  background: var(--surface-2); color: var(--text-2);
}
.tag-python { background: var(--brand-soft); color: var(--brand-d); }
.tag-scratch { background: #fef3c7; color: #92400e; }
.tag-ok { background: #e8f7ee; color: #15803d; }
.tag-warn { background: #fdf3e3; color: #92600a; }
.tag-red { background: #fef2f2; color: var(--red); }

/* ---------------- 头像 ---------------- */
.avatar {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: var(--surface-2); flex-shrink: 0;
}
.avatar-lg { width: 128rpx; height: 128rpx; }
.avatar-sm { width: 48rpx; height: 48rpx; }
.avatar-fallback {
  display: flex; align-items: center; justify-content: center;
  background: var(--ink); color: #fff; font-weight: 650; font-size: 26rpx;
}

/* ---------------- 列表 ---------------- */
.list { background: var(--surface); border-radius: var(--radius); overflow: hidden; border: 1rpx solid var(--border); }
.list-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx; border-bottom: 1rpx solid var(--border);
}
.list-item:last-child { border-bottom: none; }
.list-item:active { background: var(--surface-2); }
.list-arrow { color: #c4c4cc; font-size: 28rpx; margin-left: 12rpx; }

/* ---------------- 宫格 / 统计 ---------------- */
.stats { display: flex; }
.stat { flex: 1; text-align: center; }
.stat .v { font-size: 40rpx; font-weight: 700; letter-spacing: -0.5rpx; }
.stat .k { font-size: 22rpx; color: var(--muted); margin-top: 4rpx; }
.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; }
.grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20rpx; }

/* ---------------- 空状态 / 加载 ---------------- */
.empty { padding: 120rpx 40rpx; text-align: center; color: var(--muted); }
.empty .e-icon { font-size: 64rpx; opacity: 0.55; }
.empty .e-text { margin-top: 16rpx; font-size: 26rpx; }
.loading { padding: 60rpx; text-align: center; color: var(--muted); font-size: 24rpx; }

/* ---------------- 底部安全区 ---------------- */
.safe-bottom { height: calc(24rpx + env(safe-area-inset-bottom)); }
.footer-bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 20;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid var(--border);
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  display: flex; align-items: center; gap: 16rpx;
}

/* ---------------- 作品卡片 ---------------- */
.p-card {
  background: var(--surface); border: 1rpx solid var(--border);
  border-radius: var(--radius); overflow: hidden;
}
.p-thumb {
  width: 100%; height: 220rpx; background: var(--surface-2);
  display: flex; align-items: center; justify-content: center;
}
.p-thumb image { width: 100%; height: 100%; }
.p-thumb .ph { font-size: 34rpx; font-weight: 700; color: #a1a1aa; letter-spacing: 2rpx; }
.p-body { padding: 20rpx 22rpx 24rpx; }
.p-title { font-size: 28rpx; font-weight: 600; line-height: 1.4; }
.p-meta { display: flex; align-items: center; gap: 10rpx; margin-top: 14rpx; color: var(--muted); font-size: 22rpx; }

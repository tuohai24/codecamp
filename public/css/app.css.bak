:root {
  --brand: #5b5bd6;
  --brand-d: #4a45c4;
  --brand-2: #8b5cf6;
  --pink: #ff5c8a;
  --amber: #ffb703;
  --green: #16a34a;
  --bg: #f6f7fb;
  --surface: #ffffff;
  --surface-2: #fbfbfe;
  --text: #171a2e;
  --muted: #6b7280;
  --border: #e6e7f0;
  --radius: 16px;
  --shadow-sm: 0 1px 2px rgba(23, 26, 46, 0.06), 0 1px 3px rgba(23, 26, 46, 0.04);
  --shadow: 0 8px 24px rgba(23, 26, 46, 0.08);
  --shadow-lg: 0 20px 48px rgba(23, 26, 46, 0.16);
  --header-h: 64px;
  color-scheme: light;
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body {
  font-family: system-ui, -apple-system, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  background: var(--bg);
  color: var(--text);
  font-size: 14px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}
a { color: inherit; text-decoration: none; }
button, input, select, textarea { font-family: inherit; font-size: inherit; color: inherit; }
img { max-width: 100%; display: block; }
h1, h2, h3, h4 { margin: 0; line-height: 1.3; font-weight: 700; letter-spacing: -0.01em; }
::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-thumb { background: #d3d5e3; border-radius: 8px; border: 2px solid transparent; background-clip: content-box; }
::-webkit-scrollbar-thumb:hover { background: #b9bcd1; background-clip: content-box; }

/* ---------- 布局 ---------- */
.container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
.container-wide { max-width: 1400px; margin: 0 auto; padding: 0 20px; }

header.topbar {
  position: sticky; top: 0; z-index: 50; height: var(--header-h);
  background: rgba(255, 255, 255, 0.86);
  backdrop-filter: saturate(1.6) blur(14px);
  border-bottom: 1px solid var(--border);
}
.topbar .container-wide { height: 100%; display: flex; align-items: center; gap: 22px; }
.brand { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 17px; letter-spacing: -0.02em; }
.brand .logo {
  width: 34px; height: 34px; border-radius: 11px; display: grid; place-items: center;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-2) 60%, var(--pink) 100%);
  color: #fff; font-size: 17px; box-shadow: 0 6px 16px rgba(91, 91, 214, 0.35);
}
.nav { display: flex; align-items: center; gap: 4px; }
.nav a {
  padding: 7px 12px; border-radius: 10px; color: var(--muted); font-weight: 600; font-size: 13.5px;
  transition: 0.16s;
}
.nav a:hover { color: var(--text); background: #f0f1f8; }
.nav a.active { color: var(--brand); background: #eef0ff; }
.topbar .spacer { flex: 1; }
.searchbox { position: relative; width: 220px; }
.searchbox input {
  width: 100%; height: 36px; border-radius: 10px; border: 1px solid var(--border);
  background: #fafafe; padding: 0 12px 0 34px; outline: none; transition: 0.16s;
}
.searchbox input:focus { border-color: #c3c4f0; box-shadow: 0 0 0 3px #eef0ff; background: #fff; }
.searchbox::before { content: "🔍"; position: absolute; left: 11px; top: 8px; font-size: 13px; opacity: 0.6; }

.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 7px;
  height: 36px; padding: 0 16px; border-radius: 10px; border: 1px solid transparent;
  background: #f0f1f8; color: var(--text); font-weight: 600; cursor: pointer;
  transition: 0.16s; white-space: nowrap; font-size: 13.5px;
}
.btn:hover { background: #e7e9f5; }
.btn:active { transform: translateY(1px); }
.btn.primary { background: linear-gradient(135deg, var(--brand), var(--brand-2)); color: #fff; box-shadow: 0 6px 16px rgba(91, 91, 214, 0.28); }
.btn.primary:hover { filter: brightness(1.06); }
.btn.ghost { background: transparent; border-color: var(--border); }
.btn.ghost:hover { background: #f7f8fd; border-color: #d5d7e8; }
.btn.danger { background: #fff1f2; color: #e11d48; }
.btn.danger:hover { background: #ffe4e6; }
.btn.sm { height: 30px; padding: 0 11px; font-size: 12.5px; border-radius: 8px; }
.btn.lg { height: 46px; padding: 0 24px; font-size: 15px; border-radius: 12px; }
.btn:disabled { opacity: 0.55; cursor: not-allowed; }

.avatar {
  width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; flex: 0 0 auto;
  background: linear-gradient(135deg, #c7d2fe, #ddd6fe); color: #4338ca; font-weight: 700; font-size: 13px;
  overflow: hidden; object-fit: cover;
}
.avatar.lg { width: 56px; height: 56px; font-size: 20px; }
.avatar.sm { width: 26px; height: 26px; font-size: 11px; }

.usermenu { display: flex; align-items: center; gap: 8px; padding: 4px 8px 4px 4px; border-radius: 999px; cursor: pointer; transition: 0.16s; }
.usermenu:hover { background: #f0f1f8; }

/* ---------- 通用卡片 ---------- */
.card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow-sm); }
.panel { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 18px; }
.page { padding: 26px 0 60px; }
.page-title { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 18px; flex-wrap: wrap; }
.page-title h1 { font-size: 22px; }
.page-title .sub { color: var(--muted); font-size: 13px; margin-top: 4px; }
.section-title { display: flex; align-items: baseline; gap: 10px; margin: 28px 0 14px; }
.section-title h2 { font-size: 17px; }
.section-title .hint { color: var(--muted); font-size: 12.5px; }
.muted { color: var(--muted); }
.tiny { font-size: 12px; }
.center { text-align: center; }
.row { display: flex; align-items: center; gap: 10px; }
.row.wrap { flex-wrap: wrap; }
.col { display: flex; flex-direction: column; gap: 10px; }
.grow { flex: 1; }
.hidden { display: none !important; }

.pill {
  display: inline-flex; align-items: center; gap: 5px; height: 24px; padding: 0 9px; border-radius: 999px;
  background: #f0f1f8; color: var(--muted); font-size: 12px; font-weight: 600;
}
.pill.brand { background: #eef0ff; color: var(--brand-d); }
.pill.green { background: #e9f9ef; color: var(--green); }
.pill.amber { background: #fff7e6; color: #b45309; }
.pill.pink { background: #fff0f4; color: #be123c; }

/* ---------- 作品卡片 ---------- */
.grid { display: grid; gap: 18px; }
.grid.cards { grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); }
.work-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; transition: 0.2s; display: flex; flex-direction: column; cursor: pointer; }
.work-card:hover { transform: translateY(-3px); box-shadow: var(--shadow); border-color: #d9dbf0; }
.work-thumb { position: relative; aspect-ratio: 4 / 3; background: linear-gradient(135deg, #eef0ff, #f7f2ff); overflow: hidden; }
.work-thumb img { width: 100%; height: 100%; object-fit: cover; }
.work-thumb .ph { position: absolute; inset: 0; display: grid; place-items: center; font-size: 44px; }
.work-thumb .type-badge {
  position: absolute; left: 10px; top: 10px; height: 22px; padding: 0 8px; border-radius: 7px;
  background: rgba(255, 255, 255, 0.92); font-size: 11px; font-weight: 700; display: flex; align-items: center; gap: 4px;
  box-shadow: var(--shadow-sm); backdrop-filter: blur(6px);
}
.work-thumb .type-badge.py { color: #0f766e; }
.work-thumb .type-badge.sc { color: #b45309; }
.work-body { padding: 12px 14px 14px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
.work-body h3 { font-size: 14.5px; font-weight: 700; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
.work-body .desc { color: var(--muted); font-size: 12.5px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 34px; }
.work-meta { display: flex; align-items: center; gap: 8px; margin-top: auto; color: var(--muted); font-size: 12px; }
.work-meta .dot { opacity: 0.4; }

/* ---------- 表单 ---------- */
.field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; }
.field > label { font-size: 13px; font-weight: 600; color: #3b3f58; }
.input, input[type="text"], input[type="password"], input[type="number"], input[type="date"], select, textarea {
  height: 38px; border-radius: 10px; border: 1px solid var(--border); background: #fafafe;
  padding: 0 12px; outline: none; transition: 0.16s; width: 100%;
}
textarea { height: auto; min-height: 92px; padding: 10px 12px; resize: vertical; line-height: 1.6; }
.input:focus, input:focus, select:focus, textarea:focus { border-color: #b9bbee; box-shadow: 0 0 0 3px #eef0ff; background: #fff; }
select { cursor: pointer; }
.field .help { font-size: 12px; color: var(--muted); }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
@media (max-width: 640px) { .form-row { grid-template-columns: 1fr; } }

/* ---------- 表格 ---------- */
.table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
.table th { text-align: left; font-weight: 600; color: var(--muted); font-size: 12.5px; padding: 10px 12px; border-bottom: 1px solid var(--border); white-space: nowrap; }
.table td { padding: 12px; border-bottom: 1px solid #f0f1f8; vertical-align: middle; }
.table tr:hover td { background: #fafbff; }
.table .actions { display: flex; gap: 6px; justify-content: flex-end; }

/* ---------- Tabs ---------- */
.tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--border); margin-bottom: 18px; overflow-x: auto; }
.tabs button {
  background: none; border: none; padding: 10px 14px; font-weight: 600; color: var(--muted); cursor: pointer;
  border-bottom: 2px solid transparent; transition: 0.16s; white-space: nowrap;
}
.tabs button:hover { color: var(--text); }
.tabs button.active { color: var(--brand); border-bottom-color: var(--brand); }
.tabs.side { flex-direction: column; border-bottom: none; border-right: 1px solid var(--border); padding-right: 8px; margin: 0; }
.tabs.side button { text-align: left; border-bottom: none; border-left: 2px solid transparent; border-radius: 8px; }
.tabs.side button.active { background: #eef0ff; border-left-color: var(--brand); }

/* ---------- 弹窗 ---------- */
.modal-mask { position: fixed; inset: 0; background: rgba(20, 22, 40, 0.42); backdrop-filter: blur(3px); display: grid; place-items: center; z-index: 200; padding: 20px; }
.modal { background: #fff; border-radius: 18px; box-shadow: var(--shadow-lg); width: 100%; max-width: 520px; max-height: 88vh; overflow: auto; animation: pop 0.18s ease-out; }
@keyframes pop { from { transform: translateY(12px) scale(0.98); opacity: 0; } }
.modal-head { display: flex; align-items: center; justify-content: space-between; padding: 18px 20px 10px; }
.modal-head h3 { font-size: 16px; }
.modal-body { padding: 6px 20px 18px; }
.modal-foot { display: flex; justify-content: flex-end; gap: 8px; padding: 0 20px 20px; }
.icon-btn { width: 30px; height: 30px; border-radius: 8px; border: none; background: transparent; cursor: pointer; color: var(--muted); font-size: 16px; }
.icon-btn:hover { background: #f0f1f8; color: var(--text); }

/* ---------- Toast ---------- */
#toasts { position: fixed; top: 76px; right: 20px; z-index: 300; display: flex; flex-direction: column; gap: 8px; }
.toast {
  min-width: 200px; max-width: 340px; padding: 11px 14px; border-radius: 11px; background: #171a2e; color: #fff;
  font-size: 13px; box-shadow: var(--shadow-lg); animation: slidein 0.2s ease-out; display: flex; gap: 8px; align-items: flex-start;
}
.toast.err { background: #b31d3c; }
.toast.ok { background: #14532d; }
@keyframes slidein { from { transform: translateX(20px); opacity: 0; } }

/* ---------- 空状态 ---------- */
.empty { padding: 56px 20px; text-align: center; color: var(--muted); }
.empty .icon { font-size: 40px; margin-bottom: 10px; opacity: 0.7; }
.empty h3 { font-size: 15px; color: var(--text); margin-bottom: 6px; }

/* ---------- 首页 Hero ---------- */
.hero { position: relative; overflow: hidden; border-radius: 24px; padding: 46px 44px; margin-top: 22px; color: #fff;
  background: radial-gradient(circle at 12% 20%, #7c7cf0 0%, #5b5bd6 42%, #4338ca 100%); }
.hero::after { content: ""; position: absolute; right: -60px; top: -80px; width: 320px; height: 320px; border-radius: 50%; background: radial-gradient(circle, rgba(255,255,255,.28), transparent 65%); }
.hero::before { content: ""; position: absolute; right: 120px; bottom: -90px; width: 200px; height: 200px; border-radius: 50%; background: radial-gradient(circle, rgba(255,92,138,.5), transparent 65%); }
.hero h1 { font-size: 34px; letter-spacing: -0.02em; margin-bottom: 12px; line-height: 1.25; }
.hero p { color: rgba(255,255,255,.86); max-width: 520px; font-size: 14.5px; }
.hero .actions { display: flex; gap: 10px; margin-top: 22px; flex-wrap: wrap; position: relative; z-index: 2; }
.hero .btn.white { background: #fff; color: var(--brand-d); box-shadow: 0 10px 24px rgba(0,0,0,.18); }
.hero .btn.outline { background: rgba(255,255,255,.14); color: #fff; border: 1px solid rgba(255,255,255,.4); backdrop-filter: blur(6px); }
.hero .stats { display: flex; gap: 26px; margin-top: 28px; position: relative; z-index: 2; }
.hero .stats b { font-size: 20px; display: block; }
.hero .stats span { color: rgba(255,255,255,.75); font-size: 12px; }
@media (max-width: 760px) { .hero { padding: 30px 22px; } .hero h1 { font-size: 25px; } .hero .stats { gap: 16px; } }

/* ---------- 作品详情 ---------- */
.detail-grid { display: grid; grid-template-columns: 1fr 340px; gap: 20px; align-items: start; }
@media (max-width: 900px) { .detail-grid { grid-template-columns: 1fr; } }
.player-box { background: #fff; border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
.player-toolbar { display: flex; align-items: center; gap: 8px; padding: 10px 14px; border-bottom: 1px solid var(--border); background: var(--surface-2); }
.code-view { background: #0f172a; color: #e2e8f0; font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 12.5px; line-height: 1.65; padding: 16px; margin: 0; overflow: auto; max-height: 560px; white-space: pre; }

.comment { display: flex; gap: 10px; padding: 12px 0; border-bottom: 1px solid #f0f1f8; }
.comment:last-child { border-bottom: none; }
.comment .meta { font-size: 12px; color: var(--muted); display: flex; gap: 8px; align-items: center; }
.comment .content { font-size: 13.5px; margin-top: 2px; word-break: break-word; }

/* ---------- 学习中心侧栏 ---------- */
.layout-side { display: grid; grid-template-columns: 190px 1fr; gap: 24px; align-items: start; }
@media (max-width: 820px) { .layout-side { grid-template-columns: 1fr; } }

.stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 14px; }
.stat-card { background: #fff; border: 1px solid var(--border); border-radius: 14px; padding: 16px; }
.stat-card .label { color: var(--muted); font-size: 12.5px; }
.stat-card .value { font-size: 24px; font-weight: 800; margin-top: 4px; letter-spacing: -0.02em; }
.stat-card .foot { font-size: 12px; color: var(--muted); margin-top: 2px; }

/* ---------- 登录 ---------- */
.auth-wrap { min-height: calc(100vh - var(--header-h)); display: grid; place-items: center; padding: 40px 20px; }
.auth-card { width: 100%; max-width: 400px; background: #fff; border: 1px solid var(--border); border-radius: 20px; padding: 30px; box-shadow: var(--shadow); }
.auth-card h1 { font-size: 21px; margin-bottom: 6px; }
.auth-card .tip { color: var(--muted); font-size: 13px; margin-bottom: 22px; }

/* ---------- 编辑器（studio） ---------- */
body.studio { height: 100vh; overflow: hidden; background: #eef0f7; }
.studio-top { height: 52px; display: flex; align-items: center; gap: 12px; padding: 0 14px; background: #fff; border-bottom: 1px solid var(--border); }
.studio-top .name-input { border: 1px solid transparent; background: transparent; font-weight: 700; font-size: 14px; height: 32px; padding: 0 8px; border-radius: 8px; width: 220px; }
.studio-top .name-input:hover { background: #f5f6fb; }
.studio-top .name-input:focus { background: #fff; border-color: var(--border); box-shadow: none; }
.split { display: flex; height: calc(100vh - 52px); }
.pane-left { flex: 1; min-width: 0; position: relative; }
#blockly { position: absolute; inset: 0; }
/* Scratch 3 官方积木工具箱 */
.blocklyToolboxDiv { padding-left: 0 !important; }
.blocklyToolboxDiv .blocklyTreeLabel { font-size: 12.5px !important; font-family: inherit !important; }
.blocklyToolboxDiv .blocklyTreeRow { padding-right: 6px !important; }
.pane-right { width: 460px; flex: 0 0 460px; border-left: 1px solid var(--border); background: #fff; display: flex; flex-direction: column; overflow: hidden; }
.pane-right.collapsed { width: 0; flex-basis: 0; }
.stage-wrap { padding: 12px; background: #f7f8fd; border-bottom: 1px solid var(--border); display: grid; place-items: center; }
#stage { background: #87ceeb; border-radius: 10px; box-shadow: var(--shadow-sm); display: block; width: 100%; max-width: 436px; aspect-ratio: 4/3; }
.sprite-list { display: flex; gap: 8px; flex-wrap: wrap; padding: 10px 12px; border-bottom: 1px solid var(--border); max-height: 132px; overflow: auto; }
.sprite-chip { width: 62px; border-radius: 10px; border: 2px solid transparent; background: #f7f8fd; cursor: pointer; padding: 4px; text-align: center; transition: 0.14s; }
.sprite-chip:hover { background: #eef0ff; }
.sprite-chip.active { border-color: var(--brand); background: #eef0ff; }
.sprite-chip .thumb { height: 38px; display: grid; place-items: center; font-size: 22px; }
.sprite-chip .thumb img { height: 34px; width: auto; }
.sprite-chip .nm { font-size: 10.5px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sprite-actions { display: flex; gap: 6px; padding: 0 12px 10px; }
.lib-panel { flex: 1; overflow: auto; padding: 10px 12px 20px; }
.lib-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(84px, 1fr)); gap: 8px; }
.lib-item { border: 1px solid var(--border); border-radius: 10px; padding: 6px; background: #fff; cursor: pointer; text-align: center; transition: 0.14s; }
.lib-item:hover { border-color: var(--brand); box-shadow: 0 4px 12px rgba(91,91,214,.14); }
.lib-item .box { height: 52px; display: grid; place-items: center; }
.lib-item .box img { max-height: 50px; width: auto; }
.lib-item .nm { font-size: 10.5px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tab-strip { display: flex; gap: 4px; padding: 8px 12px 0; border-bottom: 1px solid var(--border); }
.tab-strip button { background: none; border: none; padding: 7px 10px; font-size: 12.5px; font-weight: 600; color: var(--muted); cursor: pointer; border-bottom: 2px solid transparent; }
.tab-strip button.active { color: var(--brand); border-bottom-color: var(--brand); }

/* Python 编辑器 */
.py-split { display: grid; grid-template-columns: 1fr 420px; height: calc(100vh - 52px); }
@media (max-width: 1100px) { .py-split { grid-template-columns: 1fr; grid-template-rows: 1fr 300px; } }
#editor { height: 100%; overflow: auto; }
.CodeMirror { height: 100% !important; font-size: 13.5px; font-family: ui-monospace, SFMono-Regular, Consolas, monospace; }
.output-pane { border-left: 1px solid var(--border); background: #fff; display: flex; flex-direction: column; min-height: 0; }
.out-head { display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-bottom: 1px solid var(--border); background: var(--surface-2); }
.console {
  flex: 1; background: #0f172a; color: #dbe3f4; font-family: ui-monospace, Consolas, monospace; font-size: 12.5px;
  padding: 12px; overflow: auto; white-space: pre-wrap; word-break: break-word; line-height: 1.6; min-height: 80px;
}
.console .err { color: #ff8fa3; }
.console .ok { color: #7bdcb5; }
.canvas-out { padding: 10px 12px; border-top: 1px solid var(--border); max-height: 42%; overflow: auto; background: #fff; display: flex; flex-direction: column; gap: 8px; }
.canvas-out img { background: #fff; border: 1px solid var(--border); border-radius: 8px; }

/* 素材上传 */
.upload-zone { border: 2px dashed #d5d7e8; border-radius: 12px; padding: 22px; text-align: center; color: var(--muted); cursor: pointer; transition: 0.16s; background: #fafbff; }
.upload-zone:hover, .upload-zone.over { border-color: var(--brand); background: #eef0ff; color: var(--brand-d); }
.asset-card { border: 1px solid var(--border); border-radius: 12px; overflow: hidden; background: #fff; }
.asset-card .thumb { height: 88px; display: grid; place-items: center; background: #f7f8fd; }
.asset-card .thumb img { max-height: 76px; width: auto; }
.asset-card .info { padding: 8px 10px; }
.asset-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(132px, 1fr)); gap: 12px; }

/* 响应式 */
@media (max-width: 920px) {
  .searchbox { display: none; }
  .nav a { padding: 7px 9px; }
  .pane-right { display: none; }
  .py-split { grid-template-columns: 1fr; }
}
@media (max-width: 640px) {
  .topbar .container-wide { gap: 10px; }
  .nav { gap: 0; }
  .hero .stats { display: none; }
  .grid.cards { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
}

/* ---------- Scratch 3 编辑器（官方内核） ---------- */
.s3-main { display: flex; height: calc(100vh - 52px); }
.s3-code { flex: 1; min-width: 0; position: relative; background: #fff; }
.s3-side { width: 420px; flex: 0 0 420px; border-left: 1px solid var(--border); background: #fff; display: flex; flex-direction: column; overflow: hidden; }
.s3-targets { display: flex; gap: 8px; overflow: auto; padding: 10px 12px; border-bottom: 1px solid var(--border); }
.s3-target { min-width: 60px; max-width: 76px; border: 2px solid transparent; border-radius: 10px; background: #f7f8fd; padding: 5px 3px; text-align: center; cursor: pointer; transition: .14s; }
.s3-target:hover { background: #eef0ff; }
.s3-target.active { border-color: var(--brand); background: #eef0ff; }
.s3-target .th { height: 28px; display: grid; place-items: center; font-size: 15px; font-weight: 700; color: #5b5bd6; }
.s3-target .nm { font-size: 10.5px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.s3-panel { flex: 1; overflow: auto; padding: 12px; }
.s3-costumes { display: flex; flex-direction: column; gap: 6px; }
.s3-costume { display: flex; gap: 8px; align-items: center; padding: 6px 8px; border: 1px solid var(--border); border-radius: 8px; font-size: 12px; cursor: pointer; background: #fff; }
.s3-costume:hover { border-color: var(--brand); }
.s3-costume.active { border-color: var(--brand); background: #eef0ff; }
.s3-costume span { width: 18px; height: 18px; border-radius: 5px; background: #eef0ff; color: #5b5bd6; font-size: 10.5px; display: grid; place-items: center; }
.lib-grid-wrap { max-height: calc(100vh - 440px); overflow: auto; padding-right: 2px; }
.s3-side #stage { max-width: 396px; }
#btn-run.running { background: #22a06b !important; border-color: #22a06b !important; color: #fff !important; }
.blocklyToolboxCategory { font-weight: 600; }
.player-slot { padding: 14px; display: grid; place-items: center; background: #f7f8fd; min-height: 300px; }
.blocklyFlyoutBackground { fill: #fbfbfe; fill-opacity: 1; }
.blocklyFlyout { border-right: 1px solid var(--border); }

/* ---------- 创作页：官方 Scratch 编辑器 iframe 容器 ---------- */
.frame-wrap { position: relative; height: calc(100vh - 52px); background: #fff; }
.frame-wrap iframe { display: block; width: 100%; height: 100%; border: 0; }
.frame-mask {
  position: absolute; inset: 0; display: flex; flex-direction: column; gap: 12px;
  align-items: center; justify-content: center;
  background: #f6f8ff; color: var(--muted); font-size: 13px; z-index: 3;
  transition: opacity .25s;
}
.frame-mask.hide { opacity: 0; pointer-events: none; }
.spinner {
  width: 26px; height: 26px; border-radius: 50%;
  border: 3px solid #dfe3f5; border-top-color: var(--brand);
  animation: spin .8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* 响应式 */
@media (max-width: 920px) {
  .searchbox { display: none; }
  .nav a { padding: 7px 9px; }
  .pane-right { display: none; }
  .py-split { grid-template-columns: 1fr; }
}
@media (max-width: 640px) {
  .topbar .container-wide { gap: 10px; }
  .nav { gap: 0; }
  .hero .stats { display: none; }
  .grid.cards { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
}

/* ---------- Scratch 3 编辑器（官方内核） ---------- */
.s3-main { display: flex; height: calc(100vh - 52px); }
.s3-code { flex: 1; min-width: 0; position: relative; background: #fff; }
.s3-side { width: 420px; flex: 0 0 420px; border-left: 1px solid var(--border); background: #fff; display: flex; flex-direction: column; overflow: hidden; }
.s3-targets { display: flex; gap: 8px; overflow: auto; padding: 10px 12px; border-bottom: 1px solid var(--border); }

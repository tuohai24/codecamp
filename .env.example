# CodeCamp 环境配置示例
# 复制为 .env 后填写（.env 不会被 git 跟踪，升级时也不会被覆盖）

# ---- 服务监听 ----
PORT=3000
HOST=0.0.0.0

# ---- 登录令牌签名密钥（务必改成随机字符串，长度 >= 32）----
APP_SECRET=change-me-to-a-long-random-string

# ---- 微信小程序（不填则小程序登录不可用，Web 端不受影响）----
# 微信公众平台 → 开发管理 → 开发设置 → AppID / AppSecret
WX_APPID=
WX_SECRET=

# ---- 可选：Python 装包镜像 ----
# PIP_INDEX=https://mirrors.aliyun.com/pypi/simple
